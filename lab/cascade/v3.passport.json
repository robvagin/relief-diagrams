{
  "id": "cascade-v3",
  "title": "Cascade · plant",
  "blurb": "Loan book as a living organism of matte discs and paper sheets: area is exposure, distance is share.",
  "version": "0.3.0",
  "engineHash": "0070d5dccf781c8c397c1e1cba81f6263f0cd285b60245525a969af354713e06",
  "kind": "engine",
  "contract": {
    "embed": {
      "params": [
        "embed",
        "theme",
        "p",
        "seed",
        "preset",
        "mode",
        "reduced"
      ],
      "aliases": [
        "noui",
        "panel=off"
      ]
    },
    "postMessage": {
      "out": [
        "ready",
        "frame"
      ],
      "in": [
        "es:progress",
        "es:replay",
        "pause",
        "play"
      ],
      "selfplay": true
    },
    "api": [
      "Scene.set",
      "Scene.get",
      "Scene.export",
      "KIT.scene.register",
      "KIT.scene.start"
    ]
  },
  "params": [
